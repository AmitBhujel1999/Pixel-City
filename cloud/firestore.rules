rules_version = '2';
// Pixel's City cloud saves.
// Players: each device signs in anonymously and reads/writes only under its sync code (players/<code>/...).
// A sync code is 12 random letters and numbers, so it works like a password: devices that know it share cities.
// Owner: the Google account below can read every player's cities and devices (owner page).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email == 'amitbhujel3aa@gmail.com' && request.auth.token.email_verified == true;
    }
    function goodCode(code) { return code.matches('^[A-Z2-9]{12}$'); }

    match /players/{code} {
      match /cities/{city} {
        allow read, write: if signedIn() && goodCode(code);
        allow delete: if isOwner();
        match /parts/{part} {
          allow read: if signedIn() && goodCode(code);
          allow write: if signedIn() && goodCode(code) && part.matches('^p[0-9]{2}$');
          allow delete: if isOwner();
        }
      }
      match /devices/{device} {
        allow read, write: if signedIn() && goodCode(code);
      }
    }

    // owner page: list everything across players
    match /{path=**}/cities/{city} { allow read: if isOwner(); }
    match /{path=**}/devices/{device} { allow read: if isOwner(); }
    match /{path=**}/parts/{part} { allow read: if isOwner(); }
  }
}
